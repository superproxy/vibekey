{
  "schema": "vibekey.keymap/v1",
  "name": "vibekey v1",
  "title": "快意编程 v1 / vibekey",
  "device": {
    "product": "Xiaomi Bluetooth Remote 2 Pro",
    "model": "RC003"
  },
  "software": {
    "name": "AxonKey",
    "testedVersion": "1.9.6",
    "platform": "Windows"
  },
  "disclaimer": "This is a reusable keymap convention for the official AxonKey CLI. It is not an official AxonKey backup or import file. Bind apps to the application ID AxonKey observes on your machine. Do not copy another machine's paths, instance IDs, or profile UUIDs.",
  "rules": [
    "Empty slots preserve the remote's original input and do not inherit the global profile.",
    "Shared habits must be written into every application profile.",
    "Foreground application switching uses the whole profile when auto-switch is on.",
    "Unlisted double-click and long-press slots stay preserved."
  ],
  "sharedMappings": [
    {
      "button": "up",
      "trigger": "click",
      "action": {
        "type": "wheel",
        "direction": "up"
      }
    },
    {
      "button": "down",
      "trigger": "click",
      "action": {
        "type": "wheel",
        "direction": "down"
      }
    },
    {
      "button": "back",
      "trigger": "click",
      "action": {
        "type": "key",
        "key": "Esc"
      }
    },
    {
      "button": "home",
      "trigger": "click",
      "action": {
        "type": "shortcut",
        "keys": [
          "Alt",
          "Tab"
        ]
      },
      "note": "Switches to the previous app. The shortcut is a full press-and-release, so the switcher usually does not stay open."
    },
    {
      "button": "confirm",
      "trigger": "click",
      "action": {
        "type": "key",
        "key": "Enter"
      },
      "note": "May send a chat message or run a terminal command when that field is focused."
    },
    {
      "button": "confirm",
      "trigger": "longPress",
      "action": {
        "type": "preserve"
      }
    },
    {
      "button": "voice",
      "trigger": "all",
      "action": {
        "type": "preserve"
      },
      "note": "Voice is a hold-to-talk virtual microphone path, not a start-recording shortcut."
    },
    {
      "button": "volumeUp",
      "trigger": "all",
      "action": {
        "type": "preserve"
      }
    },
    {
      "button": "volumeDown",
      "trigger": "all",
      "action": {
        "type": "preserve"
      }
    },
    {
      "button": "power",
      "trigger": "all",
      "action": {
        "type": "preserve"
      }
    },
    {
      "button": "tv",
      "trigger": "all",
      "action": {
        "type": "preserve"
      }
    }
  ],
  "profiles": [
    {
      "name": "快意编程v1-全局",
      "role": "global",
      "bindTo": null,
      "overrides": [
        {
          "button": "menu",
          "trigger": "click",
          "action": {
            "type": "preserve"
          }
        },
        {
          "button": "left",
          "trigger": "click",
          "action": {
            "type": "preserve"
          }
        },
        {
          "button": "right",
          "trigger": "click",
          "action": {
            "type": "preserve"
          }
        }
      ]
    },
    {
      "name": "快意编程v1-Grok Bot",
      "role": "application",
      "bindTo": {
        "app": "Grok Bot",
        "matchHint": "Grok Bot.exe, use the application ID AxonKey observes"
      },
      "overrides": [
        {
          "button": "left",
          "trigger": "click",
          "action": {
            "type": "shortcut",
            "keys": [
              "Alt",
              "Up"
            ]
          },
          "source": "Grok Bot official default, feel not formally accepted"
        },
        {
          "button": "right",
          "trigger": "click",
          "action": {
            "type": "shortcut",
            "keys": [
              "Alt",
              "Down"
            ]
          },
          "source": "Grok Bot official default, feel not formally accepted"
        },
        {
          "button": "menu",
          "trigger": "click",
          "action": {
            "type": "preserve"
          }
        }
      ]
    },
    {
