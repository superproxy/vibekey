  "plannedProfiles": [
    {
      "name": "快意编程v1-Cursor",
      "status": "not_landed",
      "reason": "Create and bind only after AxonKey has observed a real Cursor application ID in the foreground. Do not invent the ID.",
      "bindTo": {
        "app": "Cursor",
        "matchHint": "Cursor.exe, only after AxonKey observes it"
      },
      "overrides": [
        {
